{
  "name": "zenquant-web-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "web": "./bin/zenquant serve",
    "web:demo": "./bin/zenquant serve --engineering",
    "legacy:web": "uv run zenquant-web --host 127.0.0.1 --port 8090 --mode live",
    "legacy:web:demo": "uv run zenquant-web --host 127.0.0.1 --port 8090 --mode demo",
    "build:web": "cd web-src && npm run build:only",
    "dev:web": "cd web-src && npm run dev",
    "test:store": "node --test tests_js/storeCore.test.mjs",
    "test:e2e": "playwright test",
    "test:frontend": "npm run test:store && npm run test:e2e",
    "build": "make build",
    "start": "./bin/zenquant serve",
    "check": "make check",
    "build:options": "make build",
    "start:options": "./bin/zenquant serve",
    "test:options": "npm --prefix options-ui test && playwright test --config playwright.options.config.js",
    "test:paper": "playwright test --config playwright.paper.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  }
}
